---
import '../styles/global.css';
import { Icon } from 'astro-icon/components';

const titulo = "Bitácora de Soporte y Equipamiento";
const subtitulo = "Supervisa el estado preventivo, correctivo y de entrega de todos los activos de TI en tiempo real.";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{titulo}</title>
		<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	</head>
	<body class="bg-[#0e1726] text-slate-100 min-h-screen">
		<!-- NUEVA BARRA SUPERIOR (TOPBAR) -->
		<header class="bg-[#111927] border-b border-slate-800 px-6 py-3 flex justify-between items-center">
			<div class="flex items-center gap-3">
				<div class="w-10 h-10 rounded-xl bg-linear-to-br from-[#0284c7] to-[#e95076] flex items-center justify-center text-lg shadow-blue-500/20">
					<div class="w-10 h-10 rounded-xl bg-linear-to-br from-[#0284c7] to-[#e95076] flex items-center justify-center text-white shadow-blue-500/20">
    					<Icon name="lucide:wrench" class="w-5 h-5" />
							</div>
				</div>
				<div>
					<div class="flex items-center gap-2.5">
						<h2 class="font-bold text-white text-base tracking-tight">Control & Gestión de Mantenimientos TI</h2>
						<span class="bg-blue-500/15 text-blue-400 border border-blue-500/30 text-[11px] font-semibold px-2.5 py-0.5 rounded-full">
							ST 1.0
						</span>
					</div>
					<p class="text-xs text-slate-400">Laptops, PCs, Servidores, Impresoras y Redes • AM TI</p>
				</div>
			</div>

			<div class="flex items-center gap-2.5">
				<button class="p-2 rounded-lg bg-slate-800/70 hover:bg-slate-700 border border-slate-700/60 text-slate-300 cursor-pointer transition-all duration-200 hover:border-blue-400/60 hover:scale-105 active:scale-95 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/30">
					<Icon name="lucide:sun" class="w-4 h-4 text-amber-400" />
				</button>
				
				<button class="px-3 py-1.5 rounded-lg bg-slate-800/70 hover:bg-slate-700 border border-slate-700/60 text-slate-300 text-xs font-medium flex items-center gap-1.5 cursor-pointer transition-all duration-200 hover:border-blue-400/60 hover:scale-105 active:scale-95 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/30">
					<Icon name="lucide:globe" class="w-3.5 h-3.5 text-sky-400" />
					<span>ES</span>
					<Icon name="lucide:chevron-down" class="w-3 h-3 opacity-70" />
				</button>

				<button class="p-2 rounded-lg bg-slate-800/70 hover:bg-slate-700 border border-slate-700/60 text-slate-300 cursor-pointer transition-all duration-200 hover:border-blue-400/60 hover:scale-105 active:scale-95 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/30">
					<Icon name="lucide:bell" class="w-4 h-4 text-amber-300" />
				</button>
				
				<button class="px-3 py-1.5 rounded-lg bg-slate-800/70 hover:bg-slate-700 border border-slate-700/60 text-slate-200 text-xs font-medium flex items-center gap-2 cursor-pointer transition-all duration-200 hover:border-blue-400/60 hover:scale-105 active:scale-95 focus:outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/30">
					<span class="w-5 h-5 rounded-full bg-indigo-500 flex items-center justify-center text-[10px] font-bold text-white">
						<Icon name="lucide:user" class="w-3 h-3" />
					</span>
					<span>Admin TI</span>
					<Icon name="lucide:chevron-down" class="w-3 h-3 opacity-70" />
				</button>
			</div>
		</header>

		<!-- NUEVO 2: CONTENEDOR CENTRADO Y PESTAÑAS -->
	<div class="max-w-7xl mx-auto p-6">
		<div class="flex flex-wrap justify-between items-center gap-4 mb-6">
			<nav class="bg-[#131d31] border border-slate-800 p-1.5 rounded-xl flex items-center gap-1">
				
				<a
					href="/"
					class="bg-blue-600 text-white text-xs font-semibold px-4 py-2 rounded-lg flex items-center gap-2 shadow-lg shadow-blue-500/35 border border-blue-400/80 ring-2 ring-blue-500/30 cursor-pointer transition-all duration-200 hover:scale-105 active:scale-95"
				>
					<Icon name="lucide:layout-grid" class="w-4 h-4 text-white" />
					<span>Dashboard General</span>
				</a>	
				
				<div class="relative group">
					<button
							type="button"
							class="text-slate-400 hover:text-white text-xs font-medium px-4 py-2 rounded-lg flex items-center gap-2 cursor-pointer transition-all duration-200 hover:scale-105 active:scale-95 hover:bg-slate-800/60 border border-transparent"
					>
							<Icon name="lucide:server" class="w-4 h-4 text-sky-400" />
							<span>Equipamientos</span>
							<span class="bg-blue-500/20 text-sky-400 border border-blue-500/30 text-[10px] font-bold px-1.5 py-0.5 rounded-full">0</span>
							<Icon name="lucide:chevron-down" class="w-3 h-3 opacity-60 transition-transform duration-200 group-hover:rotate-180" />
					</button>
					<div class="absolute left-0 top-full pt-2 w-72 hidden group-hover:block z-50 transition-all duration-200">
						<div class="bg-[#111927] border border-slate-700/80 rounded-2xl p-2 shadow-2xl shadow-black/80 flex flex-col gap-1 backdrop-blur-md">
							<a
								href="/equipaments"
								class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item cursor-pointer"
							>
								<div class="flex items-center gap-3">
									<div class="w-9 h-9 rounded-xl bg-sky-500/15 border border-sky-500/30 flex items-center justify-center text-sky-400">
										<Icon name="lucide:clipboard-list" class="w-4 h-4" />
									</div>
									<div class="text-left">
										<span class="text-xs font-bold text-white block">Bitácora</span>
										<span class="text-[10px] text-slate-400 block">Equipamientos y Mantenimiento</span>
									</div>

								</div>
								<Icon name="lucide:chevron-right" class="w-3.5 h-3.5 text-slate-500 group-hover/item:text-slate-300 group-hover/item:translate-x-0.5 transition-all" />
							</a>

							<div class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item cursor-pointer">
								<div class="flex items-center gap-3">
									<div class="w-9 h-9 rounded-xl bg-purple-500/15 border border-purple-500/30 flex items-center justify-center text-purple-400">
										<Icon name="lucide:sliders-horizontal" class="w-4 h-4" />
									</div>
									<div class="text-left">
										<span class="text-xs font-bold text-white block">Configuración de Tipos</span>
										<span class="text-[10px] text-slate-400 block">Áreas, sucursales y activos</span>
									</div>
								</div>
								<Icon name="lucide:chevron-right" class="w-3.5 h-3.5 text-slate-500 group-hover/item:text-slate-300 group-hover/item:translate-x-0.5 transition-all" />
						
							</div>
						</div>			
					</div>
				</div>

				<button class="text-slate-400 hover:text-white text-xs font-medium px-4 py-2 rounded-lg flex item-center gap-2 transition-color cursor-pointer">
					<Icon name="lucide:users" class="w-4 h-4 text-purple-400" />
					<span>Usuarios</span>
					<span class="bg-blue-500/20 text-purple-400 border border-purple-500/30 text-[10px] font-bold px-1.5 py-0.5 rounded-full">0</span>
				</button>
			</nav>
			
			
			<div class="text-xs text-slate-400 flex items-center gap-1.5">
				<Icon name="lucide:sparkles" class="w-4 h-4 text-sky-400 " />
				<span>Vista activa:</span>
				<strong class="text-slate-200">Resumen y Métricas</strong>
			</div>
		</div>
	

		<!-- BANNER SUPERIOR CON TAILWIND -->
		<header class="bg-linear-to-r from-[#0284c7] to-[#e95076] rounded-2xl p-6 shadow-xl flex justify-between items-center mb-6 border via-[#7c3aed]">
			<div class="info-banner">
				<span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400 uppercase tracking-wider mb-1">
					<Icon name="lucide:wifi" class="w-4 h-4 text-emerald-400 " />
					<span>Bitácora Activa Conectada</span>
				</span>
				<h1 class="text-2xl md:text-3xl font-bold text-white mb-1">{titulo}</h1>
				<p class="text-slate-300 text-sm">{subtitulo}</p>
			</div>

			<a href="/equipaments" class="bg-white/10 hover:bg-white/20 text-white text-sm font-medium px-4 py-2 rounded-xl border border-white/20 backdrop-blur-sm cursor-pointer transition-all duration-200 hover:scale-105 active:scale-95 inline-block">
				+ Nuevo Registro
			</a>
		</header>

		<!-- SECCIÓN DE TARJETAS KPI -->
		<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
			
			<div class="bg-[#132235] border border-slate-700/50 border-b-2 rounded-2xl p-5 shadow-lg flex justify-between items-center">
				<div>
					<span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1.5">Total Mantenimientos</span>
					<div class="flex items-baseline gap-2 mb-1">
						<span class="text-3xl font-extrabold text-white">0</span>
						<span class="text-xs text-sky-400 font-medium">Equipos en bitácora</span>
					</div>
					<span class="text-xs text-slate-400 block">Total acumulado registrado</span>
				</div>
				<div class="p-2.5 bg-blue-500/10 rounded-xl text-blue-400">
					<Icon name="lucide:layers" class="w-5 h-5" />
				</div>
			</div>

			<div class="bg-[#132235] border border-slate-700/50 border-b-2 rounded-2xl p-5 shadow-lg flex justify-between items-center">
				<div>
					<span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1.5">Concluidos / OK</span>
					<div class="flex items-baseline gap-2 mb-1">
						<span class="text-3xl font-extrabold text-emerald-400">0</span>
						<span class="text-[11px] bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded font-bold">0% tasa</span>
					</div>
					<span class="text-xs text-slate-400 block">Equipos listos y entregados</span>
				</div>
				<div class="p-2.5 bg-emerald-500/10 rounded-xl text-emerald-400">
					<Icon name="lucide:check-circle" class="w-5 h-5" />
				</div>
			</div>

			<div class="bg-[#132235] border border-slate-700/50 border-b-2 rounded-2xl p-5 shadow-lg flex justify-between items-center">
				<div>
					<span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1.5">En Soporte</span>
					<div class="flex items-baseline gap-2 mb-1">
						<span class="text-3xl font-extrabold text-amber-400">0</span>
						<span class="text-xs text-amber-400 font-medium">En taller</span>
					</div>
					<span class="text-xs text-slate-400 block">Mantenimiento activo en curso</span>
				</div>
				<div class="p-2.5 bg-amber-500/10 rounded-xl text-amber-400">
					<Icon name="lucide:cog" class="w-5 h-5 animate-[spin_7s_linear_infinite]" />
				</div>
			</div>

			<div class="bg-[#132235] border border-slate-700/50 border-b-2 rounded-2xl p-5 shadow-lg flex justify-between items-center">
				<div>
					<span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1.5">Pendientes / Pieza</span>
					<div class="flex items-baseline gap-2 mb-1">
						<span class="text-3xl font-extrabold text-rose-400">0</span>
						<span class="text-xs text-rose-400 font-medium">Atención</span>
					</div>
					<span class="text-xs text-slate-400 block">En espera de refacción o pieza</span>
				</div>
				<div class="p-2.5 bg-rose-500/10 rounded-xl text-rose-400">
					<Icon name="lucide:alert-circle" class="w-5 h-5" />
				</div>
			</div>

		</section>

		<!-- SECCIÓN DE GRÁFICAS -->
		<section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">

			<!-- Gráfica 1: Dona -->
			<div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
				<div class="flex justify-between items-start mb-4">
					<div>
						<h3 class="text-white font-semibold text-base">Distribución por Estatus</h3>
						<p class="text-slate-400 text-xs">Proporción de entregas vs pendientes</p>
					</div>
					<span class="text-base opacity-75">
						<Icon name="lucide:pie-chart" class="w-4 h-4 text-slate-400 opacity-75" />
					</span>
				</div>
				<div class="relative h-80 flex w-full">
					<canvas id="graficaDona"></canvas>
				</div>
			</div>

			<!-- Gráfica 2: Barras -->
			<div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
				<div class="flex justify-between items-start mb-4">
					<div>
						<h3 class="text-white font-semibold text-base">Mantenimientos por Tipo de Equipo</h3>
						<p class="text-slate-400 text-xs">Desglose de activos atendidos</p>
					</div>
					<span class="text-base opacity-75">
						<Icon name="lucide:bar-chart" class="w-4 h-4 text-slate-400 opacity-75" />
					</span>
				</div>
				<div class="relative h-80 flex w-full">
					<canvas id="graficaBarras"></canvas>
				</div>
			</div>

			<!-- Gráfica 3: Línea -->
			 <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
				<div class="flex justify-between items-start mb-4">
					<div>
						<h3 class="text-white font-semibold text-base">Rendimiento Mensual</h3>
						<p class="text-slate-400 text-xs">Servicios registrados en el mes</p>
					</div>
					<span class="text-base opacity-75">
						<Icon name="lucide:trending-up" class="w-4 h-4 text-slate-400 opacity-75" />
					</span>
				</div>
				<div class="relative h-80 flex w-full">
					<canvas id="graficaLinea"></canvas>
				</div>
			 </div>
		</section>
		
		</div>

								<!-- GRAFICAS -->
<!-- GRAFICAS -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// 1. GRÁFICA DE DONA (Con aro gris neutro al estar en 0)
		const ctxDona = document.getElementById('graficaDona');
		if (ctxDona) {
			new Chart(ctxDona, {
				type: 'doughnut',
				data: {
					labels: ['Sin registros aún'],
					datasets: [{
						data: [1], // Valor 1 para que sí dibuje el anillo gris
						backgroundColor: ['#283845'],
						borderWidth: 0
					}]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					cutout: '72%',
					plugins: {
						legend: {
							position: 'bottom',
							labels: { color: '#94a3b8', usePointStyle: true, pointStyle: 'rect' }
						}
					}
				}
			});
		}

		// 2. GRÁFICA DE BARRAS
		const ctxBarras = document.getElementById('graficaBarras');
		if (ctxBarras) {
			new Chart(ctxBarras, {
				type: 'bar',
				data: {
					labels: ['Laptops', 'PCs', 'Servidores', 'Impresoras', 'Redes'],
					datasets: [{
						label: 'Equipos',
						data: [0, 0, 0, 0, 0],
						backgroundColor: '#38bdf8',
						borderRadius: 6
					}]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					plugins: { legend: { display: false } },
					scales: {
						x: { ticks: { color: '#94a3b8' }, grid: { display: false } },
						y: { ticks: { color: '#94a3b8', stepSize: 1 }, grid: { color: '#1e293b' }, beginAtZero: true }
					}
				}
			});
		}

		// 3. GRÁFICA DE LÍNEA
		const ctxLinea = document.getElementById('graficaLinea');
		if (ctxLinea) {
			new Chart(ctxLinea, {
				type: 'line',
				data: {
					labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May'],
					datasets: [{
						label: 'Servicios',
						data: [0, 0, 0, 0, 0],
						borderColor: '#818cf8',
						backgroundColor: 'rgba(129, 140, 248, 0.2)',
						fill: true,
						tension: 0.4
					}]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					plugins: { legend: { display: false } },
					scales: {
						x: { ticks: { color: '#94a3b8' }, grid: { display: false } },
						y: { ticks: { color: '#94a3b8', stepSize: 1 }, grid: { color: '#1e293b' }, beginAtZero: true }
					}
				}
			});
		}
	}); // <-- Aquí cierra todo el DOMContentLoaded hasta el final
</script>

	</body>
</html>