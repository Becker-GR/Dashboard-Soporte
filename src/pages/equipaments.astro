---
import '../styles/global.css';
import { Icon } from 'astro-icon/components';

const titulo = "Equipamientos y Bitácora de Mantenimiento";
const subtitulo = "Consulta, filtra e inspecciona el historial técnico y fotográfico de cada equipo registrado.";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{titulo} - Control TI</title>
    </head>
    <body class="bg-[#0e1726] text-slate-100 min-h-screen">
        
        <!-- BARRA SUPERIOR (TOPBAR) -->
        <header class="bg-[#111927] border-b border-slate-800 px-6 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-linear-to-br from-[#0284c7] to-[#e95076] flex items-center justify-center text-white shadow-blue-500/20">
                    <Icon name="lucide:wrench" class="w-5 h-5" />
                </div>
                <div>
                    <div class="flex items-center gap-2.5">
                        <h2 class="font-bold text-base tracking-tight text-white">Control & Gestión de Mantenimientos TI</h2>
                        <span class="bg-blue-500/15 text-blue-400 border border-blue-500/30 text-[11px] font-semibold px-2.5 py-0.5 rounded-full">
                            v2.6 Enterprise
                        </span>
                    </div>
                    <p class="text-xs text-slate-400">Laptops, PCs, Servidores, Impresoras y Redes • AM TI</p>
                </div>
            </div>

            <div class="flex items-center gap-2.5">
                <button class="p-2 rounded-lg bg-slate-800/70 hover:bg-slate-700 border border-slate-700/60 text-slate-300 cursor-pointer">
                    <Icon name="lucide:sun" class="w-4 h-4 text-amber-400" />
                </button>
                <button class="px-3 py-1.5 rounded-lg bg-slate-800/70 hover:bg-slate-700 border border-slate-700/60 text-slate-300 text-xs font-medium flex items-center gap-1.5 cursor-pointer">
                    <Icon name="lucide:globe" class="w-3.5 h-3.5 text-sky-400" />
                    <span>ES</span>
                    <Icon name="lucide:chevron-down" class="w-3 h-3 opacity-70" />
                </button>
                <button class="p-2 rounded-lg bg-slate-800/70 hover:bg-slate-700/60 text-slate-300 cursor-pointer">
                    <Icon name="lucide:bell" class="w-4 h-4 text-amber-300" />
                </button>
                <button class="px-3 py-1.5 rounded-lg bg-slate-800/70 hover:bg-slate-700 border border-slate-700/60 text-slate-200 text-xs font-medium flex items-center gap-2 cursor-pointer">
                    <span class="w-5 h-5 rounded-full bg-indigo-500 flex items-center justify-center text-[10px] font-bold text-white">
                        <Icon name="lucide:user" class="w-3 h-3" />
                    </span>
                    <span>Admin TI</span>
                    <Icon name="lucide:chevron-down" class="w-3 h-3 opacity-70" />
                </button>
            </div>
        </header>

        <!-- CONTENEDOR PRINCIPAL CENTRADO (Envuelve todo hasta el final) -->
        <div class="max-w-7xl mx-auto p-6">
            
            <!-- PESTAÑAS Y VISTA ACTIVA -->
            <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
                <nav class="bg-[#131d31] border border-slate-800 p-1.5 rounded-xl flex items-center gap-1">
                    <!-- 1. Enlace para volver a Dashboard General -->
                    <a 
                        href="/" 
                        class="text-slate-400 hover:text-white text-xs font-medium px-4 py-2 rounded-lg flex items-center gap-2 cursor-pointer transition-all duration-200 hover:scale-105 active:scale-95 hover:bg-slate-800/60 border border-transparent"
                    >
                        <Icon name="lucide:layout-grid" class="w-4 h-4" />
                        <span>Dashboard General</span>
                    </a>

                    <!-- 2. Equipamientos Activo con Desplegable Hover -->
                    <div class="relative group">
                        <!-- Botón Activo iluminado -->
                        <button
                            type="button"
                            class="bg-blue-600 text-white text-xs font-semibold px-4 py-2 rounded-lg flex items-center gap-2 shadow-lg shadow-blue-500/35 border border-blue-400/80 ring-2 ring-blue-500/30 cursor-pointer transition-all duration-200 hover:scale-105 active:scale-95"
                        >
                            <Icon name="lucide:server" class="w-4 h-4 text-white" />
                            <span>Equipamientos</span>
                            <span class="bg-blue-500/40 text-white border border-blue-300/60 text-[10px] font-bold px-1.5 py-0.5 rounded-full">1</span>
                            <Icon name="lucide:chevron-down" class="w-3 h-3 opacity-90 transition-transform duration-200 group-hover:rotate-180" />
                        </button>

                        <!-- Menú Flotante Desplegable -->
                        <div class="absolute left-0 top-full pt-2 w-72 hidden group-hover:block z-50 transition-all duration-200">
                            <div class="bg-[#111927] border border-slate-700/80 rounded-2xl p-2 shadow-2xl shadow-black/80 flex flex-col gap-1 backdrop-blur-md">
                                
                                <!-- Opción 1: Bitácora -->
                                <a 
                                    href="/equipaments" 
                                    class="flex items-center justify-between p-2.5 rounded-xl bg-slate-800/40 hover:bg-slate-800/80 transition-colors group/item cursor-pointer"
                                >
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-sky-500/15 border border-sky-500/30 flex items-center justify-center text-sky-400">
                                            <Icon name="lucide:clipboard-list" class="w-4 h-4" />
                                        </div>
                                        <div class="text-left">
                                            <span class="text-xs font-bold text-white block">Bitácora</span>
                                            <span class="text-[10px] text-slate-400 block">Equipamientos y Mantenimiento</span>
                                        </div>
                                    </div>
                                    <Icon name="lucide:chevron-right" class="w-3.5 h-3.5 text-slate-500 group-hover/item:text-slate-300 group-hover/item:translate-x-0.5 transition-all" />
                                </a>

                                <!-- Opción 2: Configuración de Tipos -->
                                <div class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item cursor-pointer">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-purple-500/15 border border-purple-500/30 flex items-center justify-center text-purple-400">
                                            <Icon name="lucide:sliders-horizontal" class="w-4 h-4" />
                                        </div>
                                        <div class="text-left">
                                            <span class="text-xs font-bold text-white block">Configuración de Tipos</span>
                                            <span class="text-[10px] text-slate-400 block">Áreas, sucursales y activos</span>
                                        </div>
                                    </div>
                                    <Icon name="lucide:chevron-right" class="w-3.5 h-3.5 text-slate-500 group-hover/item:text-slate-300 group-hover/item:translate-x-0.5 transition-all" />
                                </div>

                            </div>
                        </div>
                    </div>

                    <button class="text-slate-400 hover:text-white text-xs font-medium px-4 py-2 rounded-lg flex items-center gap-2 transition-colors cursor-pointer">
                        <Icon name="lucide:users" class="w-4 h-4 text-purple-400" />
                        <span>Usuarios</span>
                        <span class="bg-purple-500/20 text-purple-400 border border-purple-500/30 text-[10px] font-bold px-1.5 py-0.5 rounded-full">0</span>
                    </button>
                </nav>

                <div class="text-xs text-slate-400 flex items-center gap-1.5">
                    <Icon name="lucide:hard-drive" class="w-4 h-4 text-sky-400" />
                    <span>Vista activa:</span>
                    <strong class="text-slate-200">Bitácora de Equipos</strong>
                </div>
            </div>

            <!-- BANNER DEL MÓDULO BITÁCORA -->
            <header class="bg-[#15233c] border border-slate-700/60 rounded-2xl p-6 shadow-xl flex flex-wrap justify-between items-center gap-4 mb-6">
                <div>
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-400 uppercase tracking-wider mb-1">
                        <Icon name="lucide:box" class="w-4 h-4" />
                        Módulo de Inventario y Bitácora
                    </span>
                    <h1 class="text-2xl font-bold text-white mb-1">{titulo}</h1>
                    <p class="text-slate-300 text-sm">{subtitulo}</p>
                </div>

                <div class="flex items-center gap-3">
                    <a href="/" class="bg-slate-800/90 hover:bg-slate-700 text-slate-200 text-sm font-medium px-4 py-2 rounded-xl border border-slate-600/60 transition-all flex items-center gap-2 cursor-pointer">
                        <Icon name="lucide:arrow-left" class="w-4 h-4" />
                        Volver al Dashboard
                    </a>
                    <button class="bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium px-4 py-2 rounded-xl shadow-lg shadow-blue-600/30 transition-all flex items-center gap-2 cursor-pointer">
                        <Icon name="lucide:plus" class="w-4 h-4" />
                        Agregar Equipo
                    </button>
                </div>
            </header>

            <!-- TARJETA PRINCIPAL DE LA BITÁCORA -->
            <section class="bg-[#101b2b] border border-slate-800 rounded-2xl p-6 shadow-xl">

                <!-- Cabecera de la tabla y herramientas -->
                <div class="flex flex-wrap justify-between items-center gap-4 pb-6 border-b border-slate-800/80">
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 bg-blue-500/10 rounded-xl text-blue-400">
                            <Icon name="lucide:database" class="w-5 h-5" />
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-white">Bitácora de Registros de Mantenimiento</h3>
                            <p class="text-xs text-slate-400">Visualiza, filtra y examina el detalle fotográfico y técnico de cada equipo</p>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2.5">
                        <span class="bg-slate-800/90 text-slate-300 border border-slate-700 text-xs px-3 py-1.5 rounded-lg font-medium">
                            Mostrando 1 de 1 registros
                        </span>
                    
                        <button class="bg-slate-800 hover:bg-slate-700 border border-slate-700/80 text-slate-200 text-xs font-medium px-3 py-1.5 rounded-lg flex items-center gap-1.5 cursor-pointer">
                            <Icon name="lucide:download" class="w-3.5 h-3.5 text-sky-400" />
                            Exportar
                            <Icon name="lucide:chevron-down" class="w-3 h-3 opacity-60" />
                        </button>
                        <button class="bg-slate-800 hover:bg-slate-700 border border-slate-700/80 text-slate-200 text-xs font-medium px-3 py-1.5 rounded-lg flex items-center gap-1.5 cursor-pointer">
                            <Icon name="lucide:sliders-horizontal" class="w-3.5 h-3.5 text-sky-400" />
                            Encabezados
                            <Icon name="lucide:chevron-down" class="w-3 h-3 opacity-60" />
                        </button>
                        <button class="text-sky-400 hover:text-sky-300 text-xs font-semibold px-2 py-1.5 cursor-pointer">
                            Limpiar filtros
                        </button>
                    </div>
                </div>

                <!-- Barra de Búsqueda y los 4 Filtros en Grid -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-3 py-5">
                    <!-- Buscador -->
                    <div class="relative">
                        <Icon name="lucide:search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
                        <input
                            type="text"
                            placeholder="Buscar modelo, folio, técnico..."
                            class="w-full bg-[#0b1320] border border-slate-800 rounded-xl pl-10 pr-4 py-2 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500 transition-colors"
                        />
                    </div>

                    <!-- Filtro Área -->
                    <select class="bg-[#0b1320] border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-300 focus:outline-none focus:border-blue-500 cursor-pointer">
                        <option value="">Todas las Áreas / Sucursales</option>
                        <option value="ventas">Ventas / 209</option>
                        <option value="sistemas">Sistemas</option>
                        <option value="almacen">Almacén</option>
                    </select>

                    <!-- Filtro Tipo de Equipo -->
                    <select class="bg-[#0b1320] border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-300 focus:outline-none focus:border-blue-500 cursor-pointer">
                        <option value="">Todos los Tipos de Equipo</option>
                        <option value="laptop">Laptop</option>
                        <option value="pc">PC de Escritorio</option>
                        <option value="servidor">Servidor</option>
                        <option value="impresora">Impresora</option>
                    </select>

                    <!-- Filtro Estatus -->
                    <select class="bg-[#0b1320] border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-300 focus:outline-none focus:border-blue-500 cursor-pointer">
                        <option value="">Todos los Estatus</option>
                        <option value="concluido">Concluido / En Stock</option>
                        <option value="soporte">En Soporte</option>
                        <option value="pendiente">Pendiente</option>
                    </select>
                </div>

                <!-- TABLA DE EQUIPOS -->
                <div class="overflow-x-auto rounded-xl border border-slate-800/80">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-[#0b1320] text-slate-400 font-semibold border-b border-slate-800">
                                <th class="p-4">FOLIO / FECHA</th>
                                <th class="p-4">ÁREA / SUCURSAL</th>
                                <th class="p-4">EQUIPO & MODELO</th>
                                <th class="p-4">TIPO DE SERVICIO</th>
                                <th class="p-4">ESTATUS</th>
                                <th class="p-4">EVIDENCIAS</th>
                                <th class="p-4 text-center">ACCIONES</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-slate-800/60 bg-[#0e1726]/40">
                            <!-- Fila 1 de Ejemplo -->
                            <tr class="hover:bg-slate-800/30 transition-colors">
                                <td class="p-4">
                                    <span class="font-bold text-white block">MNT-2026-001</span>
                                    <span class="text-[11px] text-slate-400">23/10/2026</span>
                                </td>
                                <td class="p-4">
                                    <div class="flex items-center gap-2">
                                        <Icon name="lucide:calculator" class="w-4 h-4 text-slate-400" />
                                        <div>
                                            <span class="font-semibold text-white block">Ventas / 209</span>
                                            <span class="text-[11px] text-slate-400 flex items-center gap-1">
                                                <Icon name="lucide:user" class="w-3 h-3" /> Ing. Juan
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <div class="flex items-center gap-2">
                                        <Icon name="lucide:laptop" class="w-4 h-4 text-slate-400" />
                                        <div>
                                            <span class="font-semibold text-white block">DELL Inspiron</span>
                                            <span class="text-[11px] text-slate-400">Laptop • S/N: 74767334555</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <span class="text-white font-medium block">Mantenimiento Preventivo</span>
                                    <span class="text-[11px] text-slate-400">Téc: Becker Garcia</span>
                                </td>
                                <td class="p-4">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                                        Concluido / En Stock
                                    </span>
                                </td>
                                <td class="p-4">
                                    <div class="flex items-center gap-1.5">
                                        <div class="w-7 h-7 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center overflow-hidden">
                                            <span class="text-xs">🍓</span>
                                        </div>
                                        <div class="w-7 h-7 rounded-lg bg-slate-800/60 border border-dashed border-slate-700 flex items-center justify-center text-slate-500 text-[10px]">
                                            ---
                                        </div>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <div class="flex items-center justify-center gap-2.5">
                                        <button title="Ver detalle" class="text-sky-400 hover:text-sky-300 transition-colors cursor-pointer">
                                            <Icon name="lucide:eye" class="w-4 h-4" />
                                        </button>
                                        <button title="Editar" class="text-amber-400 hover:text-amber-300 transition-colors cursor-pointer">
                                            <Icon name="lucide:pencil" class="w-4 h-4" />
                                        </button>
                                        <button title="Eliminar" class="text-rose-400 hover:text-rose-300 transition-colors cursor-pointer">
                                            <Icon name="lucide:trash-2" class="w-4 h-4" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pie de la Bitácora -->
                <p class="text-[11px] text-slate-400 mt-4">
                    Bitácora compatible con formato de Excel estándar (.xlsx) de 7 columnas
                </p>

            </section>
        </div>
    </body>
</html>